# CognoDB Cloud connection.
#
# Copy to .env.local and fill in the values from your CognoDB instance:
#   CognoDB Console -> your instance -> Connection details
#
# The bolt+s:// scheme is TLS-encrypted and is what CognoDB Cloud expects.
# None of these are ever exposed to the browser - every query runs server-side.

COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.com
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=<your-instance-password>
